                            }
                          ]
                        }
                      },
                      "systemPrompt": {
                        "type": "string"
                      },
                      "groupSessionScope": {
                        "type": "string",
                        "enum": [
                          "group",
                          "group_sender"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "historyLimit": {
                  "type": "integer",
                  "minimum": 0
                },
                "textChunkLimit": {
                  "type": "integer",
