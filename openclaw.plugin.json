                  ]
                },
                "asyncMode": {
                  "type": "boolean"
                },
                "ackText": {
                  "type": "string"
                },
                "endpoint": {
                  "type": "string"
                },
                "debug": {
                  "type": "boolean"
                },
                "groupReplyMode": {
                  "type": "string",
                  "enum": [
                    "aicard",
                    "text",
                    "markdown"
                  ]
                },
                "cardTemplateId": {
                  "type": "string"
                },
                "cardContentVar": {
                  "type": "string",
