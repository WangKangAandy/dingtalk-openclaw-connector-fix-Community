                          "minLength": 1
                        },
                        "id": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "source",
                        "provider",
                        "id"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "chatbotUserId": {
                  "type": "string"
                },
                "chatbotCorpId": {
                  "type": "string"
                },
                "dmPolicy": {
                  "type": "string",
                  "enum": [
                    "open",
                    "pairing",
                    "allowlist"
                  ]
                },
                "allowFrom": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
